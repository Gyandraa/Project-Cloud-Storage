// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum AccountStatus {
  PENDING
  ACTIVE
  DELETION_PENDING
}

enum OtpPurpose {
  REGISTER
  FORGOT_PASSWORD
  CHANGE_PASSWORD
}

enum FileCategory {
  KULIAH
  UMUM
}

enum TrashStatus {
  ACTIVE
  RESTORING
  PURGING
  FAILED
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
  EXPIRED
  ABORTED
}

enum DeletionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── User & Auth ────────────────────────────────────────────────────────────────

/// Pemilik semua data peribadi. Setiap kueri mesti dicakup oleh userId.
model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  accountStatus   AccountStatus @default(PENDING)
  baseQuotaBytes  BigInt        @default(7516192768) // 7 GiB
  usedBytes       BigInt        @default(0)
  reservedBytes   BigInt        @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions            Session[]
  otpChallenges       OtpChallenge[]
  semesters           Semester[]
  courses             Course[]
  folders             Folder[]
  files               File[]
  favorites           Favorite[]
  trashEntries        Trash[]
  uploadReservations  UploadReservation[]
  accountDeletionJobs AccountDeletionJob[]
}

/// Sesi sisi server. Token mentah hanya dalam kuki HttpOnly;
/// hanya hash token disimpan di sini.
model Session {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Cabaran OTP untuk pendaftaran, lupa kata laluan, dan ubah kata laluan.
/// Kod 6 digit disimpan sebagai hash selamat, bukan plaintext.
model OtpChallenge {
  id           String     @id @default(uuid())
  userId       String
  email        String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  attemptCount Int        @default(0)
  maxAttempts  Int        @default(3)
  lastSentAt   DateTime   @default(now())
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email, purpose])
}

// ─── Kuliah Hierarchy ───────────────────────────────────────────────────────────

/// Semester dalam kategori Kuliah. Pengguna membuat dan mengelola semester.
model Semester {
  id          String    @id @default(uuid())
  userId      String
  name        String
  deletedAt   DateTime?
  trashRootId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trashRoot  Trash?  @relation("TrashDescendantSemesters", fields: [trashRootId], references: [id], onDelete: SetNull)
  courses    Course[]
  trashEntry Trash?  @relation("TrashRootSemester")

  // Composite unique enables ownership-enforcing FK references from Course
  @@unique([id, userId])
  @@index([userId])
}

/// Mata Kuliah di dalam Semester. File disimpan langsung di mata kuliah.
/// Composite FK [semesterId, userId] memastikan pemilik yang sama.
model Course {
  id          String    @id @default(uuid())
  userId      String
  semesterId  String
  name        String
  deletedAt   DateTime?
  trashRootId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester @relation(fields: [semesterId, userId], references: [id, userId])
  trashRoot  Trash?   @relation("TrashDescendantCourses", fields: [trashRootId], references: [id], onDelete: SetNull)
  files      File[]
  trashEntry Trash?   @relation("TrashRootCourse")

  // Composite unique enables ownership-enforcing FK references from File
  @@unique([id, userId])
  @@index([userId])
  @@index([semesterId])
}

// ─── Umum Hierarchy ─────────────────────────────────────────────────────────────

/// Folder untuk kategori Umum dengan subfolder bersarang.
/// parentId = null bermakna folder root di dalam Umum.
/// Composite self-FK [parentId, userId] memastikan pemilik yang sama.
model Folder {
  id          String    @id @default(uuid())
  userId      String
  parentId    String?
  name        String
  deletedAt   DateTime?
  trashRootId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Folder?  @relation("FolderHierarchy", fields: [parentId, userId], references: [id, userId])
  children   Folder[] @relation("FolderHierarchy")
  trashRoot  Trash?   @relation("TrashDescendantFolders", fields: [trashRootId], references: [id], onDelete: SetNull)
  files      File[]
  trashEntry Trash?   @relation("TrashRootFolder")

  // Composite unique enables ownership-enforcing FK references
  @@unique([id, userId])
  @@index([userId])
  @@index([parentId])
}

// ─── File ───────────────────────────────────────────────────────────────────────

/// Satu tabel File untuk kedua-dua kategori Kuliah dan Umum.
/// Invarian kategori/lokasi dikuatkuasakan melalui CHECK constraint SQL.
/// Composite FK ke Course dan Folder memastikan pemilik yang sama.
model File {
  id           String       @id @default(uuid())
  userId       String
  category     FileCategory
  courseId      String?
  folderId     String?
  name         String
  originalName String?
  mimeType     String
  sizeBytes    BigInt
  storageKey   String       @unique
  checksum     String?
  deletedAt    DateTime?
  trashRootId  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?    @relation(fields: [courseId, userId], references: [id, userId])
  folder     Folder?    @relation(fields: [folderId, userId], references: [id, userId])
  trashRoot  Trash?     @relation("TrashDescendantFiles", fields: [trashRootId], references: [id], onDelete: SetNull)
  favorites  Favorite[]
  trashEntry Trash?     @relation("TrashRootFile")

  // Composite unique enables ownership-enforcing FK references from Favorite
  @@unique([id, userId])
  @@index([userId, category])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@index([userId, courseId])
  @@index([userId, folderId])
}

// ─── Favorite ───────────────────────────────────────────────────────────────────

/// Favorit hanya untuk file, bukan folder.
/// Composite FK [fileId, userId] memastikan hanya file sendiri boleh difavoritkan.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  fileId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, fileId])
}

// ─── Trash ──────────────────────────────────────────────────────────────────────

/// Entri root Sampah yang kelihatan. Tepat satu dari fileId, folderId,
/// courseId, semesterId mesti diisi (CHECK constraint via SQL migrasi).
/// Turunan ditandai melalui trashRootId pada entiti masing-masing.
model Trash {
  id              String      @id @default(uuid())
  userId          String
  fileId          String?     @unique
  folderId        String?     @unique
  courseId         String?     @unique
  semesterId      String?     @unique
  originalName    String
  originalPath    String?
  deletedAt       DateTime    @default(now())
  expiresAt       DateTime
  status          TrashStatus @default(ACTIVE)
  deletionGroupId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootFile     File?     @relation("TrashRootFile", fields: [fileId], references: [id])
  rootFolder   Folder?   @relation("TrashRootFolder", fields: [folderId], references: [id])
  rootCourse   Course?   @relation("TrashRootCourse", fields: [courseId], references: [id])
  rootSemester Semester? @relation("TrashRootSemester", fields: [semesterId], references: [id])

  // Reverse: entiti yang mempunyai Trash ini sebagai trashRoot mereka
  descendantFiles     File[]     @relation("TrashDescendantFiles")
  descendantFolders   Folder[]   @relation("TrashDescendantFolders")
  descendantCourses   Course[]   @relation("TrashDescendantCourses")
  descendantSemesters Semester[] @relation("TrashDescendantSemesters")

  @@index([userId])
  @@index([expiresAt, status])
}

// ─── Upload ─────────────────────────────────────────────────────────────────────

/// Tempahan unggah untuk memastikan kuota selamat daripada konkurensi.
/// Setiap peralihan status mesti bersifat idempoten.
model UploadReservation {
  id                  String       @id @default(uuid())
  userId              String
  destinationCategory FileCategory
  courseId             String?
  folderId            String?
  fileName            String
  expectedSizeBytes   BigInt
  objectKey           String       @unique
  status              UploadStatus @default(PENDING)
  multipartUploadId   String?
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt, status])
}

// ─── Account Deletion ───────────────────────────────────────────────────────────

/// Pekerjaan penghapusan akaun latar belakang yang idempoten dan boleh dicuba semula.
model AccountDeletionJob {
  id           String            @id @default(uuid())
  userId       String
  status       DeletionJobStatus @default(PENDING)
  attemptCount Int               @default(0)
  lastError    String?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
